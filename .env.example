# Canonical origin used for canonical/OG URLs (defaults to the original domain).
NEXT_PUBLIC_SITE_URL=https://auctechitsolutions.in
# API adapter mode for Phase 3 UI work:
#   not-connected (default) – every form/admin action reports that the backend is not connected yet.
#   ui-preview              – resolves actions locally (nothing is sent or stored) so success states can be reviewed.
NEXT_PUBLIC_API_MODE=not-connected
